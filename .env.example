# ===================================================================
# SMART DIGITAL LICENSING PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and customize with your local credentials.
# NEVER commit .env to version control.
# ===================================================================

# Server Configuration
SERVER_PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (PostgreSQL)
# Note: On Windows if port 5432 is reserved by Hyper-V/NAT, use port 5433
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/licensing_platform
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here

# JWT Security
JWT_SECRET=your_base64_or_hex_encoded_secret_key_at_least_256_bits_length_here
JWT_EXPIRATION_MS=86400000

# Private Document Storage
STORAGE_LOCAL_DIRECTORY=./storage/private_documents

# OCR Adapter Configuration (tesseract / mock)
OCR_ENGINE_PROVIDER=mock
TESSERACT_DATA_PATH=C:/Program Files/Tesseract-OCR/tessdata
